# Firebase — ONLY needed for LIVE visitor counting
# By default the template uses a static count from constants.ts (VISITOR_STATS).
# See VISITOR_COUNTER_SETUP.md before enabling live mode.
#
# 1. Set VISITOR_STATS.enableLiveCount = true in constants.ts
# 2. Copy this file to .env and fill YOUR Firebase web app keys
# 3. Create Firestore + rules (documented in VISITOR_COUNTER_SETUP.md)

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
